{
  "name": "bluf-card-game",
  "version": "1.0.0",
  "description": "Карточная игра Верю/Не верю — мультиплеер 1–4 игрока по сети",
  "type": "module",
  "main": "server/index.js",
  "scripts": {
    "start": "node server/index.js",
    "dev": "node --watch server/index.js",
    "test": "node --test --test-concurrency=1 tests/*.js",
    "cap:sync": "npx cap sync",
    "cap:android": "npx cap open android",
    "build:apk": "node scripts/build-apk.js"
  },
  "dependencies": {
    "express": "^4.21.0",
    "socket.io": "^4.8.0"
  },
  "devDependencies": {
    "socket.io-client": "^4.8.0",
    "@capacitor/android": "^6.1.0",
    "@capacitor/cli": "^6.1.0",
    "@capacitor/core": "^6.1.0"
  },
  "capacitor": {
    "android": {
      "path": "android"
    }
  }
}
